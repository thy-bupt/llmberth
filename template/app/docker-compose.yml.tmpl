# docker-compose.yml — generated by llmberth ({{.Manifest.TemplateVersion}})
#
# Dev profile (default): postgres is ONLY published to 127.0.0.1 (so you can
# psql/air from the host); the app and its admin API are published to
# 127.0.0.1 only — never the public internet.
#
# Secrets come from the project-local .env (gitignored), never from this
# file. Inside the container both listeners bind all interfaces; the loopback
# guarantee lives in the host port mapping below.

services:
  postgres:
    # Digest-pinned (doctor --security item 5): postgres 16-alpine, 2026-09-08.
    image: postgres:16-alpine@sha256:cf78e76683b9ca8c5733cbbdce6c9262b45b6767934dd0a95e671f9a0fc20685
    environment:
      POSTGRES_USER: llmberth
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD in .env}
      POSTGRES_DB: llmberth
    ports:
      - "127.0.0.1:${POSTGRES_PORT:-15432}:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U llmberth -d llmberth"]
      interval: 2s
      timeout: 3s
      retries: 30
    networks:
      - internal
    restart: unless-stopped

  app:
    build:
      context: .
      args:
        # Module proxy override for the build stage (regional mirrors); set
        # GOPROXY in .env, defaults to the official proxy.
        GOPROXY: ${GOPROXY:-https://proxy.golang.org,direct}
    depends_on:
      postgres:
        condition: service_healthy
    env_file: .env
    environment:
      # Container-internal overrides: bind all interfaces (host publishes
      # loopback only) and reach postgres over the compose network.
      PORT: 0.0.0.0:8080
      ADMIN_PORT: 0.0.0.0:8090
      DATABASE_URL: postgres://llmberth:${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD in .env}@postgres:5432/llmberth?sslmode=disable
      APP_ENV: dev
    ports:
      - "127.0.0.1:${APP_PORT:-8080}:8080"
      - "127.0.0.1:${ADMIN_PORT:-8090}:8090"
    # Read-only rootfs + tmpfs scratch (doctor --security item 7): the app
    # never writes to its own image layer.
    read_only: true
    tmpfs:
      - /tmp
    networks:
      - internal
    restart: unless-stopped

volumes:
  pgdata:

networks:
  internal:
    driver: bridge
