# docker-compose.prod.yml — generated by llmberth ({{.Manifest.TemplateVersion}})
#
# Prod override (apply with: docker compose -f docker-compose.yml
# -f docker-compose.prod.yml up -d --wait, or `llmberth up --profile prod`):
#   - the app and postgres stop publishing host ports entirely (they are
#     reachable only inside the compose network and through Caddy)
#   - Caddy terminates TLS on 443 (automatic Let's Encrypt via the
#     Caddyfile, domain from APP_DOMAIN env) and reverse-proxies the app
#   - admin API stays loopback-only by construction: no host mapping, and
#     the app still requires ADMIN_TOKEN (fail closed)
#
# Deployment notes (see README): APP_DOMAIN must point at this host (DNS A
# record) and ports 80/443 must be reachable from the internet.

services:
  app:
    # !reset removes the dev port mappings from the base file (compose
    # multi-file merge otherwise appends).
    ports: !reset []

  postgres:
    ports: !reset []

  caddy:
    image: caddy:2-alpine
    depends_on:
      app:
        condition: service_started
    environment:
      APP_DOMAIN: ${APP_DOMAIN:?set APP_DOMAIN to your public domain}
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_conf:/config
    networks:
      - internal
    restart: unless-stopped

volumes:
  caddy_data:
  caddy_conf:
