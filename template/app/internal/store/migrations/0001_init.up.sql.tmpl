-- Six tables per plan §4.2: sessions, messages, usage_ledger, api_keys,
-- audit_log (+ embeddings reserved for the M5 --rag module, not created here).
-- Ledger / key / audit tables are append-only: the app role gets INSERT+SELECT
-- only (see prod hardening, M4).

CREATE EXTENSION IF NOT EXISTS pgcrypto;

-- Chat history (used by the bundled UI; bodies can be withheld via LOG_MESSAGES=0
-- in future hardening, ledger always records).
CREATE TABLE IF NOT EXISTS sessions (
    id         uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    title      text NOT NULL DEFAULT '',
    created_at timestamptz NOT NULL DEFAULT now()
);

CREATE TABLE IF NOT EXISTS messages (
    id         bigserial PRIMARY KEY,
    session_id uuid NOT NULL REFERENCES sessions(id) ON DELETE CASCADE,
    role       text NOT NULL CHECK (role IN ('system', 'user', 'assistant', 'tool')),
    content    text NOT NULL,
    created_at timestamptz NOT NULL DEFAULT now()
);
CREATE INDEX IF NOT EXISTS idx_messages_session ON messages (session_id, created_at);

-- Per-request token accounting. Append-only; cost_usd is an ESTIMATE from
-- models.yaml prices (see README / X-LLM-Cost-Usd header).
CREATE TABLE IF NOT EXISTS usage_ledger (
    id                bigserial PRIMARY KEY,
    key_id            uuid,
    model             text NOT NULL,
    prompt_tokens     bigint NOT NULL DEFAULT 0,
    completion_tokens bigint NOT NULL DEFAULT 0,
    cost_usd          numeric(12, 6) NOT NULL DEFAULT 0,
    created_at        timestamptz NOT NULL DEFAULT now()
);
CREATE INDEX IF NOT EXISTS idx_usage_key_time ON usage_ledger (key_id, created_at);
CREATE INDEX IF NOT EXISTS idx_usage_model_time ON usage_ledger (model, created_at);

-- API keys. Only the SHA-256 hash and an 8-char display prefix are stored;
-- the full key is shown exactly once at creation time.
CREATE TABLE IF NOT EXISTS api_keys (
    id             uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    name           text NOT NULL DEFAULT '',
    key_hash       text NOT NULL UNIQUE,
    prefix         text NOT NULL,
    scopes         text[] NOT NULL DEFAULT '{chat}',
    rate_limit_rps integer NOT NULL DEFAULT 5,
    budget_usd     numeric(12, 2),
    revoked_at     timestamptz,
    created_at     timestamptz NOT NULL DEFAULT now()
);

-- Management actions (key create/revoke, config changes). Append-only.
CREATE TABLE IF NOT EXISTS audit_log (
    id         bigserial PRIMARY KEY,
    actor      text NOT NULL,
    action     text NOT NULL,
    target     text NOT NULL DEFAULT '',
    detail     jsonb NOT NULL DEFAULT '{}'::jsonb,
    created_at timestamptz NOT NULL DEFAULT now()
);
