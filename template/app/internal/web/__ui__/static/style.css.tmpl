/* {{.Name}} bundled UI — minimal, dependency-free. */
:root { color-scheme: light dark; }
* { box-sizing: border-box; }
body {
  margin: 0; font-family: system-ui, -apple-system, sans-serif;
  background: CanvasText; background: Canvas; color: CanvasText;
}
main { max-width: 720px; margin: 0 auto; padding: 2rem 1rem 4rem; }
h1 { font-size: 1.4rem; }
.hint { color: color-mix(in srgb, CanvasText 60%, transparent); font-size: .9rem; }
#keyForm { display: flex; gap: .5rem; align-items: center; margin: 1rem 0; }
#keyForm label { font-weight: 600; }
#key { flex: 1; padding: .5rem; border: 1px solid color-mix(in srgb, CanvasText 30%, transparent); border-radius: 6px; }
#keyStatus { font-size: .85rem; }
#chat {
  border: 1px solid color-mix(in srgb, CanvasText 20%, transparent);
  border-radius: 8px; min-height: 300px; max-height: 55vh; overflow-y: auto;
  padding: 1rem; margin-bottom: 1rem; display: flex; flex-direction: column; gap: .75rem;
}
.msg { padding: .6rem .9rem; border-radius: 8px; max-width: 85%; white-space: pre-wrap; }
.msg.user { align-self: flex-end; background: #2b6cb0; color: white; }
.msg.assistant { align-self: flex-start; background: color-mix(in srgb, CanvasText 8%, Canvas); }
.msg.error { align-self: center; background: #742a2a; color: white; font-size: .9rem; }
#chatForm { display: flex; gap: .5rem; }
#prompt { flex: 1; padding: .6rem; border-radius: 6px; resize: vertical;
  border: 1px solid color-mix(in srgb, CanvasText 30%, transparent); }
button { padding: .5rem 1rem; border: none; border-radius: 6px; cursor: pointer;
  background: #2b6cb0; color: white; font-weight: 600; }
button:disabled { opacity: .5; cursor: wait; }
