func TestFakeChatComplete(t *testing.T) {
	req := ChatRequest{Model: "fake-chat"}
	req.Messages = append(req.Messages, Message{Role: "user", Content: "hello world"})
	resp, err := Fake{}.ChatComplete(context.Background(), req)
	if err != nil {
		t.Fatal(err)
	}
	if resp.Content == "" || resp.Usage.CompletionTokens == 0 {
		t.Fatalf("fake reply/usage empty: %+v", resp)
	}
}

func TestFakeStream(t *testing.T) {
	req := ChatRequest{Model: "fake-chat"}
	req.Messages = append(req.Messages, Message{Role: "user", Content: "hi"})
	deltas, err := Fake{}.StreamChat(context.Background(), req)
	if err != nil {
		t.Fatal(err)
	}
	var usage *Usage
	for d := range deltas {
		if d.Err != nil {
			t.Fatal(d.Err)
		}
		if d.Usage != nil {
			usage = d.Usage
		}
	}
	if usage == nil {
		t.Fatal("stream ended without usage")
	}
}

func TestAllowlist(t *testing.T) {
	SetAllowedHosts([]string{"api.openai.com", "127.0.0.1"})
	if !HostAllowed("https://api.openai.com/v1") {
		t.Fatal("allowlisted host rejected")
	}
	if HostAllowed("https://evil.example.com/v1") {
		t.Fatal("non-allowlisted host accepted")
	}
	if HostAllowed("") {
		t.Fatal("empty host accepted")
	}
	if _, err := NewOpenAI("https://evil.example.com/v1", "k"); err == nil {
		t.Fatal("NewOpenAI must fail closed on non-allowlisted host")
	}
}

func TestOpenAIAgainstHttptest(t *testing.T) {
	var gotAuth string
	var gotPath string
	var gotBody wireRequest
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		gotAuth = r.Header.Get("Authorization")
		gotPath = r.URL.Path
		_ = json.NewDecoder(r.Body).Decode(&gotBody)
		msg := map[string]string{"role": "assistant", "content": "pong"}
		choice := map[string]any{"message": msg}
		_ = json.NewEncoder(w).Encode(map[string]any{
			"id": "cmpl-1", "model": "test-model",
			"choices": []map[string]any{choice},
			"usage":   map[string]int64{"prompt_tokens": 3, "completion_tokens": 1},
		})
	}))
	defer srv.Close()

	SetAllowedHosts([]string{hostOf(srv.URL)})
	client, err := NewOpenAI(srv.URL, "test-key-123")
	if err != nil {
		t.Fatal(err)
	}
	req := ChatRequest{Model: "test-model"}
	req.Messages = append(req.Messages, Message{Role: "user", Content: "ping"})
	resp, err := client.ChatComplete(context.Background(), req)
	if err != nil {
		t.Fatal(err)
	}
	if resp.Content != "pong" || resp.Usage.PromptTokens != 3 {
		t.Fatalf("unexpected response: %+v", resp)
	}
	if gotAuth != "Bearer test-key-123" || gotPath != "/chat/completions" {
		t.Fatalf("request not shaped correctly: auth=%q path=%q", gotAuth, gotPath)
	}
	if gotBody.StreamOptions == nil || !gotBody.StreamOptions.IncludeUsage {
		if gotBody.Stream {
			t.Fatal("streaming request must ask for usage")
		}
	}
}

func TestOpenAIStreamAgainstHttptest(t *testing.T) {
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		w.Header().Set("Content-Type", "text/event-stream")
		f := w.(http.Flusher)
		_, _ = w.Write([]byte("data: {\"choices\":[{\"delta\":{\"content\":\"he\"}}]}\n\n"))
		f.Flush()
		_, _ = w.Write([]byte("data: {\"choices\":[{\"delta\":{\"content\":\"llo\"}}]}\n\n"))
		f.Flush()
		_, _ = w.Write([]byte("data: {\"choices\":[],\"usage\":{\"prompt_tokens\":2,\"completion_tokens\":2}}\n\n"))
		f.Flush()
		_, _ = w.Write([]byte("data: [DONE]\n\n"))
		f.Flush()
	}))
	defer srv.Close()

	SetAllowedHosts([]string{hostOf(srv.URL)})
	client, err := NewOpenAI(srv.URL, "")
	if err != nil {
		t.Fatal(err)
	}
	sreq := ChatRequest{Model: "m"}
	sreq.Messages = append(sreq.Messages, Message{Role: "user", Content: "hi"})
	deltas, err := client.StreamChat(context.Background(), sreq)
	if err != nil {
		t.Fatal(err)
	}
	var sb strings.Builder
	var usage *Usage
	for d := range deltas {
		if d.Err != nil {
			t.Fatal(d.Err)
		}
		sb.WriteString(d.Text)
		if d.Usage != nil {
			usage = d.Usage
		}
	}
	if sb.String() != "hello" {
		t.Fatalf("stream content = %q", sb.String())
	}
	if usage == nil || usage.CompletionTokens != 2 {
		t.Fatalf("stream usage missing: %+v", usage)
	}
}
