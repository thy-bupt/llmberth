// handleHealthz is the liveness probe.
func (s *Server) handleHealthz(w http.ResponseWriter, _ *http.Request) {
	writeJSON(w, http.StatusOK, map[string]string{"status": "ok"})
}

// handleMetrics emits a minimal Prometheus text exposition. Rich metrics can
// be added incrementally; the format is stable.
func (s *Server) handleMetrics(w http.ResponseWriter, _ *http.Request) {
	w.Header().Set("Content-Type", "text/plain; version=0.0.4")
	fmt.Fprintf(w,
		"# HELP llmberth_requests_total Total chat API requests.\n"+
			"# TYPE llmberth_requests_total counter\n"+
			"llmberth_requests_total %d\n"+
			"# HELP llmberth_tokens_total Total tokens (prompt + completion) seen.\n"+
			"# TYPE llmberth_tokens_total counter\n"+
			"llmberth_tokens_total %d\n",
		s.reqTotal.Load(), s.tokTotal.Load())
}

{{if .HasUI}}
// handleIndex serves the bundled single-page UI with a strict CSP (no
// inline scripts; the JS lives in /static/app.js).
func (s *Server) handleIndex(w http.ResponseWriter, _ *http.Request) {
	w.Header().Set("Content-Type", "text/html; charset=utf-8")
	w.Header().Set("Content-Security-Policy",
		"default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:")
	w.Header().Set("X-Content-Type-Options", "nosniff")
	w.Header().Set("X-Frame-Options", "DENY")
	_, _ = w.Write(web.Index())
}

// handleWebAsset serves /static/* from the embedded FS.
func (s *Server) handleWebAsset(w http.ResponseWriter, r *http.Request) {
	name := strings.TrimPrefix(r.URL.Path, "/static/")
	if name == "" || strings.Contains(name, "..") || strings.Contains(name, "/") {
		http.NotFound(w, r)
		return
	}
	data, err := web.Asset("static/" + name)
	if err != nil {
		http.NotFound(w, r)
		return
	}
	switch {
	case strings.HasSuffix(name, ".js"):
		w.Header().Set("Content-Type", "text/javascript; charset=utf-8")
	case strings.HasSuffix(name, ".css"):
		w.Header().Set("Content-Type", "text/css; charset=utf-8")
	default:
		w.Header().Set("Content-Type", "application/octet-stream")
	}
	w.Header().Set("X-Content-Type-Options", "nosniff")
	_, _ = w.Write(data)
}
