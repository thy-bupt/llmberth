# {{.Name}} — environment template. Copy to .env and fill in.
# NEVER commit .env (gitignored). Everything below documents every knob.

# --- Postgres (dev compose) -------------------------------------------
# Generate a strong value (e.g. `openssl rand -hex 24`). llmberth init fills
# it automatically.
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=15432

# DATABASE_URL as seen from inside the compose network. For host-side
# `go run` / air debugging use 127.0.0.1:<POSTGRES_PORT> instead.
DATABASE_URL=postgres://llmberth:CHANGE_ME@postgres:5432/llmberth?sslmode=disable
DATABASE_URL_HOST=postgres://llmberth:CHANGE_ME@127.0.0.1:15432/llmberth?sslmode=disable

# --- Listeners ---------------------------------------------------------
APP_PORT=8080
ADMIN_PORT=8090

# --- Admin API (llmberth CLI <-> this app, loopback only) --------------
# The CLI keeps its copy in .llmberth-admin-token (0600, gitignored).
ADMIN_TOKEN=CHANGE_ME

# --- Upstream LLM ------------------------------------------------------
LLM_PROVIDER={{.Provider.ID}}
{{if .Provider.BaseURL}}LLM_BASE_URL={{.Provider.BaseURL}}
{{end}}{{if .Provider.APIKeyEnv}}{{.Provider.APIKeyEnv}}=YOUR_UPSTREAM_KEY
{{else}}# (this provider preset needs no upstream key)
{{end -}}
LLM_MODEL={{.Provider.DefaultModel}}
# Comma-separated allowlist of upstream hosts (SSRF guard, fail closed).
# LLM_ALLOWED_HOSTS=

# --- Governance --------------------------------------------------------
RATE_LIMIT_RPS=5
BUDGET_MONTHLY_USD={{printf "%.2f" .Manifest.Budget.MonthlyUSD}}
# 1 = persist chat bodies to the DB; 0 = usage ledger only (default).
LOG_MESSAGES=0

# --- Misc --------------------------------------------------------------
APP_ENV=dev
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
