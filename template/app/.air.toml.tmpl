# .air.toml — hot reload config for `llmberth dev` (and manual `air` runs).
# Env (secrets, DATABASE_URL) is injected by `llmberth dev` from .env.
root = "."
tmp_dir = "bin/air"

[build]
# -mod=mod: a fresh project has no go.sum yet; this lets build/run work
# without a manual `go mod tidy` first (checksums are synthesized, same as
# the container build in the Dockerfile).
cmd = "go build -mod=mod -o ./bin/app ."
bin = "./bin/app"
include_ext = ["go"]
exclude_dir = ["bin", "static", "docs"]
delay = 500

[log]
time = false

[misc]
clean_on_exit = true
