# {{.Name}} developer tasks (generated by llmberth).
.PHONY: build test tidy up stop logs psql clean

build:
	go build -o bin/app .

test:
	go test ./...

tidy:
	go mod tidy

up:
	docker compose up -d --build --wait

stop:
	docker compose down

logs:
	docker compose logs -f app

psql: ## psql into the dev database (loopback published port)
	@. .env 2>/dev/null; PGPASSWORD=$$POSTGRES_PASSWORD psql -h 127.0.0.1 -p $${POSTGRES_PORT:-15432} -U llmberth -d llmberth

clean:
	rm -rf bin/
