# {{.Name}} — generated by llmberth {{.Manifest.GeneratedBy}}.
# NEVER commit this file (it is gitignored). .env.example documents every
# variable; this one carries the real values init generated for you.

# --- Postgres (dev compose) -------------------------------------------
POSTGRES_PASSWORD={{.DBPassword}}
POSTGRES_PORT=15432

# DATABASE_URL as seen from inside the compose network (docker compose sets
# this again itself). For host-side `go run` / air debugging point at the
# loopback-published port instead:
#   postgres://llmberth:{{.DBPassword}}@127.0.0.1:15432/llmberth?sslmode=disable
DATABASE_URL=postgres://llmberth:{{.DBPassword}}@postgres:5432/llmberth?sslmode=disable
DATABASE_URL_HOST=postgres://llmberth:{{.DBPassword}}@127.0.0.1:15432/llmberth?sslmode=disable

# --- Listeners ---------------------------------------------------------
# Host-side values; inside compose these are overridden to 0.0.0.0 (the
# loopback guarantee comes from the host port publishing).
APP_PORT=8080
ADMIN_PORT=8090

# --- Admin API (llmberth CLI <-> this app, loopback only) --------------
ADMIN_TOKEN={{.AdminToken}}

# --- Upstream LLM ------------------------------------------------------
LLM_PROVIDER={{.Provider.ID}}
{{if .Provider.BaseURL}}LLM_BASE_URL={{.Provider.BaseURL}}
{{end}}{{if .Provider.APIKeyEnv}}{{.Provider.APIKeyEnv}}=
{{end -}}
LLM_MODEL={{.Provider.DefaultModel}}
# SSRF guard: allowed upstream hosts (comma separated). Defaults are seeded
# from the provider preset; extend only with hosts you actually intend to use.
# LLM_ALLOWED_HOSTS=

# --- Governance --------------------------------------------------------
# Default per-key rate limit (requests/sec). Per-key values override this.
RATE_LIMIT_RPS=5
# Global monthly budget in USD (estimate); 0 disables. Per-key budgets are
# set when creating keys.
BUDGET_MONTHLY_USD={{printf "%.2f" .Manifest.Budget.MonthlyUSD}}
# 1 = persist chat bodies to the DB (sessions/messages); 0 = ledger only.
LOG_MESSAGES=0

# --- Misc --------------------------------------------------------------
APP_ENV=dev
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
