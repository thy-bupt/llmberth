# Caddyfile — generated by llmberth ({{.Manifest.TemplateVersion}})
#
# Automatic TLS via Let's Encrypt for the domain in $APP_DOMAIN (injected by
# docker-compose.prod.yml). The app is only reachable through this proxy on
# 443; the admin API has no host mapping at all (loopback by construction).
{$APP_DOMAIN} {
	reverse_proxy app:8080
}

