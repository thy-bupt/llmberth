# Binaries
/llmberth
/dist/
*.test
*.out

# Go
/vendor/

# Local env — never commit secrets
.env
.env.*
!.env.example
# ...but template SOURCES must be tracked: their names merely look like .env
!template/**/*.tmpl

# Admin token (generated per-project by llmberth init)
.llmberth-admin-token

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Golden test scratch output
/.goldenbin/

# Security-hook session artifacts (never part of the repo).
.mimosa/
